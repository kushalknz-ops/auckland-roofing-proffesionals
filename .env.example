# Optional public build setting for asset URLs. Social cards require an HTTPS
# origin serving the same build. Leave blank to use the canonical origin.
VITE_SITE_URL=

# Optional Node.js runtime settings.
CANONICAL_HOST=
PORT=
HTTP_PORT=
HTTPS_PORT=
TRUSTED_PROXY_IPS=

# Comma-separated cross-origin frontend URLs. A blank value allows same-origin access only.
# Production Node and Vite preview require HTTPS in ALLOWED_ORIGINS.
ALLOWED_ORIGINS=
# Vite dev and Node with NODE_ENV=development use this list instead.
DEV_ALLOWED_ORIGINS=

# Node.js direct HTTPS only. Set both paths together.
SSL_KEY_PATH=
SSL_CERT_PATH=

# Server runtime only. Keep SENTRY_DSN in a secret store and outside Vite variables.
SENTRY_DSN=
# For Cloudflare, explicitly set production in the production environment only.
MONITORING_ENV=
# Optional Git commit for release correlation. Pages supplies CF_PAGES_COMMIT_SHA.
MONITORING_RELEASE=
# Optional process RSS threshold in MiB. Set to the Node hosting memory budget.
MONITORING_RSS_LIMIT_MB=
