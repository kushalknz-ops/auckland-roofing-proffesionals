# Auckland Roof Professionals - Apache Configuration
# HTTP to HTTPS Redirection & SPA Routing

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Canonical Host: Redirect www to apex domain (301 Permanent Redirect)
  RewriteCond %{HTTP_HOST} ^www\.aucklandroofprofessionals\.nz$ [NC]
  RewriteRule ^(.*)$ https://aucklandroofprofessionals.nz/$1 [L,R=301]

  # 2. Canonical Protocol: Redirect HTTP to HTTPS (301 Permanent Redirect)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://aucklandroofprofessionals.nz%{REQUEST_URI} [L,R=301]

  # 3. Canonical Paths: Strip trailing slashes on sub-paths
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # 4. Serve the metadata for the requested service query.
  RewriteCond %{QUERY_STRING} (?:^|&)id=([a-z0-9]+(?:-[a-z0-9]+)*)(?:&|$)
  RewriteRule ^service$ service/%1.html [END]
  RewriteCond %{QUERY_STRING} (?:^|&)id=[^&]+
  RewriteRule ^service$ - [R=404,L]
  RewriteRule ^service$ service-default.html [END]

  # 5. Serve build-generated HTML at extensionless URLs.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-z0-9-]+(?:/[a-z0-9-]+)*)$ $1.html [END]
</IfModule>

# Custom 404 error handler
ErrorDocument 404 /404.html

# Security headers for both successful and error responses
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; script-src-attr 'none'; style-src 'self' https://fonts.googleapis.com; style-src-attr 'none'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src https://res.cloudinary.com/avvuses1/video/upload/; connect-src 'self'; frame-src https://www.google.com/maps; manifest-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), display-capture=(), xr-spatial-tracking=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-XSS-Protection "0"
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# Caching for immutable static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
